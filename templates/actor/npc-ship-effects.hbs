<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    <div class="effect-lists">

        {{!-- Temporary Effects --}}
        <div class="sheet-list">
            <div class="list-header row-content">
                <div class="list-name">{{localize "IMSC.Effects.Temporary"}}</div>
                <div class="list-controls">
                    <a class="list-control" data-action="createEffect" data-category="temporary">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>
            </div>
            <div class="list-content">
                {{#each effects.temporary}}
                <div class="list-row" data-uuid="{{this.uuid}}">
                    <div class="row-content">
                        <div class="list-name">
                            <img src="{{this.img}}">
                            <a class="label" data-action="editEmbedded" data-uuid="{{this.uuid}}">{{this.name}}</a>
                        </div>
                        <div>{{this.source}}</div>
                        <div class="list-controls">
                            <a data-action="toggleProperty" data-property="disabled" data-tooltip="Toggle">
                                {{#if this.disabled}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}
                            </a>
                            <a class="list-control" data-action="deleteEmbedded"><i class="fas fa-xmark"></i></a>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Passive Effects --}}
        <div class="sheet-list">
            <div class="list-header row-content">
                <div class="list-name">{{localize "IMSC.Effects.Passive"}}</div>
                <div class="list-controls">
                    <a class="list-control" data-action="createEffect" data-category="passive">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>
            </div>
            <div class="list-content">
                {{#each effects.passive}}
                <div class="list-row" data-uuid="{{this.uuid}}">
                    <div class="row-content">
                        <div class="list-name">
                            <img src="{{this.img}}">
                            <a class="label" data-action="editEmbedded" data-uuid="{{this.uuid}}">{{this.name}}</a>
                        </div>
                        <div>{{this.source}}</div>
                        <div class="list-controls">
                            <a data-action="toggleProperty" data-property="disabled" data-tooltip="Toggle">
                                {{#if this.disabled}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}
                            </a>
                            {{#unless this.item}}
                            <a class="list-control" data-action="deleteEmbedded"><i class="fas fa-xmark"></i></a>
                            {{/unless}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- Disabled Effects --}}
        <div class="sheet-list">
            <div class="list-header row-content">
                <div class="list-name">{{localize "IMSC.Effects.Disabled"}}</div>
                <div class="list-controls"></div>
            </div>
            <div class="list-content">
                {{#each effects.disabled}}
                <div class="list-row" data-uuid="{{this.uuid}}">
                    <div class="row-content inactive">
                        <div class="list-name">
                            <img src="{{this.img}}">
                            <a class="label" data-action="editEmbedded" data-uuid="{{this.uuid}}">{{this.name}}</a>
                        </div>
                        <div>{{this.source}}</div>
                        <div class="list-controls">
                            <a data-action="toggleProperty" data-property="disabled" data-tooltip="Toggle">
                                <i class="far fa-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

    </div>

</section>
