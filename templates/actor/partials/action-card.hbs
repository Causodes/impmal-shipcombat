{{!-- partials/action-card.hbs
     Params: role, hasPowerCore, roleId --}}

<div class="sheet-list">
    <div class="list-header row-content">
        <div class="list-name">{{localize "IMSC.Label.Standard"}}</div>
        {{> "modules/impmal-shipcombat/templates/actor/partials/payload-status-badge.hbs"
            payloadId=role.payloadId payloadLabel=role.payloadLabel payloadDesc=role.payloadDesc}}
        {{> "modules/impmal-shipcombat/templates/actor/partials/core-status-banner.hbs"
            coreCount=role.coreCount hasCoreStaged=role.hasCoreStaged}}
    </div>
    <div class="list-content">
        <div class="list-row {{#if role.standardUsed}}inactive{{/if}}">
            <div class="row-content">
                <div class="list-name">
                    <strong>{{role.standardAction.label}}</strong>
                </div>
                <div class="list-controls">
                    {{#unless role.standardUsed}}
                        <a class="list-control" data-action="performStandard" data-role-id="{{roleId}}"><i class="fa-solid fa-play"></i></a>
                    {{/unless}}
                </div>
            </div>
            <div class="description">{{role.standardAction.desc}}</div>
        </div>
    </div>
</div>

<div class="sheet-list">
    <div class="list-header row-content">
        <div class="list-name">{{localize "IMSC.Label.Overcharged"}}</div>
        {{#unless hasPowerCore}}
            <div><i class="fa-solid fa-lock" data-tooltip="{{localize "IMSC.Tooltip.NoPowerCore"}}"></i></div>
        {{/unless}}
        <div class="list-controls"></div>
    </div>
    <div class="list-content">
        <div class="list-row {{#if role.overchargedUsed}}inactive{{/if}} {{#unless hasPowerCore}}inactive{{/unless}}">
            <div class="row-content">
                <div class="list-name">
                    <strong>{{role.overchargedAction.label}}</strong>
                </div>
                <div class="list-controls">
                    {{#if hasPowerCore}}
                        {{#unless role.overchargedUsed}}
                            <a class="list-control" data-action="performOvercharged" data-role-id="{{roleId}}"><i class="fa-solid fa-bolt"></i></a>
                        {{/unless}}
                    {{/if}}
                </div>
            </div>
            <div class="description">{{role.overchargedAction.desc}}</div>
        </div>
    </div>
</div>
