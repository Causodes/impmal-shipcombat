{{!-- Enginseer: Heat Management --}}
<div class="sheet-list imsc-role-section">

    {{#unless engineerCtx.heatSelected}}
    <div class="imsc-section-overlay{{#if (imscOr (imscNot engineerCtx.hasBankedCores) (imscEq engineerCtx.actionsRemaining 0))}} imsc-section-overlay--taken{{/if}}">
        {{#if (imscNot engineerCtx.hasBankedCores)}}
            <div class="imsc-overlay-lock-indicator">
                <i class="fa-solid fa-lock fa-lg"></i>
                <span>{{localize "IMSC.Enginseer.RequiresBankedCore"}}</span>
            </div>
        {{else if (imscEq engineerCtx.actionsRemaining 0)}}
            <div class="imsc-overlay-lock-indicator">
                <i class="fa-solid fa-ban fa-lg"></i>
                <span>{{localize "IMSC.Enginseer.ActionTakenDesc"}}</span>
            </div>
        {{else}}
        <button class="imsc-section-overlay-btn" data-action="selectAction" data-action-type="heat">
            {{localize "IMSC.Enginseer.HeatManagement"}}
        </button>
        {{/if}}
    </div>
    {{/unless}}

    <div class="list-header row-content">
        <div class="list-name">{{localize "IMSC.Enginseer.HeatManagement"}}</div>
    </div>
    <div class="list-content">
        <div class="imsc-eng-action-row">
            <p class="imsc-eng-action-desc">{{localize "IMSC.Enginseer.ManageHeatDesc"}}</p>
            <div class="imsc-eng-action-ctrl">
                <button class="imsc-alloc-btn" data-action="adjustHeatCores" data-delta="-1"
                        {{#unless engineerCtx.hasBankedCores}}disabled{{/unless}}>&minus;</button>
                <span class="imsc-core-alloc-count">{{engineerCtx.heatCoresStaged}}</span>
                <button class="imsc-alloc-btn" data-action="adjustHeatCores" data-delta="1"
                        {{#unless engineerCtx.hasBankedCores}}disabled{{/unless}}>+</button>
            </div>
            <button type="button" class="imsc-eng-confirm" data-action="manageHeat"
                    {{#unless engineerCtx.hasBankedCores}}disabled{{/unless}}>
                {{localize "IMSC.Enginseer.Execute"}}
            </button>
        </div>
    </div>
</div>
