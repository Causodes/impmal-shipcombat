<div class="imsc-popout-radar-body">
    <div class="imsc-radar-wrap imsc-popout-radar-wrap">
        <canvas data-auspex-radar-popout></canvas>
        <button class="imsc-bearing-toggle-btn imsc-popout-bearing-btn" data-popout-action="toggleBearing">
            <i class="fa-solid fa-compass-drafting"></i>
            <span class="imsc-popout-bearing-label">REL</span>
        </button>
    </div>
    <div class="imsc-popout-toolbar-bottom">
        <div class="imsc-radar-zoom-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="range" class="imsc-radar-zoom imsc-popout-zoom" min="5" max="30" step="1" value="30" />
            <span class="imsc-radar-zoom-label imsc-popout-zoom-label">30</span>
        </div>
    </div>
</div>
