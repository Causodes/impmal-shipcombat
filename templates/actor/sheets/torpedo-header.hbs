<div class="imsc-header imsc-torpedo-header-block">

  <header class="sheet-header">
    <img class="profile" src="{{actor.img}}" data-action="editImage" data-edit="img">
    <div class="header-details">
      <div class="details-row name">
        <input type="text" name="name" value="{{actor.name}}" placeholder="Torpedo"
               {{#unless owner}}disabled{{/unless}}>
      </div>
      <div class="imsc-torpedo-bars">
        {{> "modules/impmal-shipcombat/templates/actor/partials/vessel-resource-bar.hbs"
            label="Warheads Lost" fillClass="hull" pct=hullPct value=sys.hull.value max=sys.hull.max}}
        {{> "modules/impmal-shipcombat/templates/actor/partials/vessel-resource-bar.hbs"
            label="Fuel" fillClass="fuel" pct=fuelPct value=sys.fuel.value max=sys.fuel.max}}
      </div>
    </div>
  </header>

</div>
