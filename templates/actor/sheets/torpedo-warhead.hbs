<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
<div class="imsc-torpedo-sheet">

    {{> "modules/impmal-shipcombat/templates/actor/partials/vessel-trait-summary.hbs"}}

    {{!-- Movement Controls --}}
    <div class="imsc-torpedo-movement">
        {{> "modules/impmal-shipcombat/templates/actor/partials/vessel-movement-controls.hbs"}}
    </div>

    {{!-- Detonate --}}
    <div class="imsc-torpedo-detonate">
        {{#if sys.designated}}
        <button type="button" data-action="detonate" class="imsc-detonate-btn" disabled
            data-tooltip="Torpedo has been designated — detonation is locked this round.">
            <i class="fas fa-lock"></i> Detonate
        </button>
        {{else}}
        <button type="button" data-action="detonate" class="imsc-detonate-btn">
            <i class="fas fa-explosion"></i> Detonate
        </button>
        {{/if}}
    </div>

    {{> "modules/impmal-shipcombat/templates/actor/partials/vessel-turn-complete.hbs"}}

</div>
</section>
