<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    {{!-- Role claim prompt --}}
    {{#with (lookup roles "captain")}}
    {{#unless isMyRole}}
        {{#unless @root.isGM}}
        <div class="sheet-list">
            <div class="list-content">
                <div class="list-row">
                    <div class="row-content">
                        <div class="list-name">{{localize "IMSC.Prompt.ClaimRole"}}</div>
                        <div class="list-controls">
                            <button data-action="claimRole" data-role-id="captain">
                                <i class="fa-solid fa-chess-queen"></i> {{localize "IMSC.Role.Captain"}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/unless}}
    {{/unless}}
    {{/with}}

    {{!-- ══════════════════════════════════════════════════════════════════════
         CAPTAIN-ONLY SECTION: conditions + cards. Hidden from other players.
    ════════════════════════════════════════════════════════════════════════ --}}
    {{#if (or isGM (lookup (lookup roles "captain") "isMyRole"))}}

    {{!-- ═══════ Status Bar (sticky, matches pattern of all other role tabs) ═══════ --}}
    <div class="sheet-list imsc-role-status-bar">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Captain.StatusTitle"}}</div>
            {{#with (lookup roles "captain")}}
            {{> "modules/impmal-shipcombat/templates/actor/partials/payload-status-badge.hbs"
                payloadId=payloadId payloadLabel=payloadLabel payloadDesc=payloadDesc}}
            {{> "modules/impmal-shipcombat/templates/actor/partials/core-status-banner.hbs"
                coreCount=coreCount hasCoreStaged=hasCoreStaged}}
            {{/with}}
        </div>
        <div class="list-content">
            <div class="imsc-role-status-panel">
                {{!-- Stance row --}}
                <div class="imsc-resource-bar-row imsc-stance-row imsc-stance--{{captainCtx.stance}} {{#if captainCtx.hasPendingStance}}imsc-stance--pending{{/if}}">
                    <span class="imsc-resource-bar-label">
                        <i class="fa-solid fa-flag"></i> {{localize "IMSC.Captain.StanceLabel"}}
                    </span>
                    <span class="imsc-stance-value"{{#if captainCtx.stanceDesc}} data-tooltip="{{captainCtx.stanceDesc}}"{{/if}}>{{captainCtx.stanceLabel}}</span>
                    {{#if captainCtx.hasPendingStance}}
                    <span class="imsc-stance-pending-hint">
                        <i class="fa-solid fa-arrow-right-long"></i> {{captainCtx.pendingLabel}}
                    </span>
                    {{/if}}
                    <div class="imsc-triage-counter"
                         data-tooltip="{{captainCtx.triageCount}}/{{captainCtx.triageMax}}: {{localize 'IMSC.Captain.TriageTooltip'}}">
                        <i class="fa-solid fa-wrench"></i>
                        {{captainCtx.triageCount}}/{{captainCtx.triageMax}}
                    </div>
                </div>
                {{!-- Auxiliary Power bar (read-only) --}}
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Enginseer.CoreBank"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--plasma">
                        <div class="imsc-resource-bar-fill" style="width: {{captainCtx.auxPowerPct}}%"></div>
                    </div>
                    <span class="imsc-resource-bar-value imsc-resource-bar-value--plasma">{{captainCtx.auxiliaryPower}}/{{captainCtx.auxPowerCapacity}}</span>
                </div>
            </div>
        </div>
    </div>

    {{!-- ═══════ Leadership Allocation ═══════ --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Captain.LeadershipAllocation"}}</div>
            <a class="imsc-full-reset-link" data-action="rollInitiative"
               data-tooltip="{{localize 'IMSC.Captain.RollInitiativeBtn'}}">
                <i class="fa-solid fa-dice-d20"></i>
            </a>
        </div>
        <div class="list-content">
            <div class="imsc-helm-stats">
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Captain.LeadershipSLTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Captain.LeadershipSL"}}</span>
                    {{#if captainCtx.leadershipRolled}}
                        <span class="imsc-helm-stat-value imsc-sl-badge">{{captainCtx.remainingLeadershipSL}}</span>
                    {{else}}
                        <button class="imsc-roll-piloting-btn" data-action="rollLeadershipSL">
                            <i class="fa-solid fa-dice"></i> {{localize "IMSC.Captain.RollLeadership"}}
                        </button>
                    {{/if}}
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Captain.InspireTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Captain.Inspire"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocLeadershipSL" data-stat="inspire" data-delta="-1"
                                {{#unless captainCtx.leadershipRolled}}disabled{{/unless}}
                                {{#unless captainCtx.allocInspire}}disabled{{/unless}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{captainCtx.allocInspire}}</span>
                        <button class="imsc-alloc-btn" data-action="allocLeadershipSL" data-stat="inspire" data-delta="1"
                                {{#unless captainCtx.leadershipRolled}}disabled{{/unless}}
                                {{#if (gte (add (add captainCtx.allocInspire captainCtx.allocResolve) captainCtx.allocInitiative) captainCtx.leadershipSL)}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Captain.ResolveTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Captain.Resolve"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocLeadershipSL" data-stat="resolve" data-delta="-1"
                                {{#unless captainCtx.leadershipRolled}}disabled{{/unless}}
                                {{#unless captainCtx.allocResolve}}disabled{{/unless}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{captainCtx.allocResolve}}</span>
                        <button class="imsc-alloc-btn" data-action="allocLeadershipSL" data-stat="resolve" data-delta="1"
                                {{#unless captainCtx.leadershipRolled}}disabled{{/unless}}
                                {{#if (gte (add (add captainCtx.allocInspire captainCtx.allocResolve) captainCtx.allocInitiative) captainCtx.leadershipSL)}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Captain.InitiativeTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Captain.AllocInitiative"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocLeadershipSL" data-stat="initiative" data-delta="-1"
                                {{#unless captainCtx.leadershipRolled}}disabled{{/unless}}
                                {{#unless captainCtx.allocInitiative}}disabled{{/unless}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{captainCtx.allocInitiative}}</span>
                        <button class="imsc-alloc-btn" data-action="allocLeadershipSL" data-stat="initiative" data-delta="1"
                                {{#unless captainCtx.leadershipRolled}}disabled{{/unless}}
                                {{#if (gte (add (add captainCtx.allocInspire captainCtx.allocResolve) captainCtx.allocInitiative) captainCtx.leadershipSL)}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- ═══════ Voidshield Allocation ═══════ --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Sensors.VoidshieldAllocation"}}</div>
        </div>
        <div class="list-content imsc-shield-alloc-row">

            {{!-- Sector max list (left) --}}
            <div class="imsc-shield-sector-list">
              <div class="imsc-ssl-head">{{localize "IMSC.Sensors.ZoneMax"}}</div>
              {{#each shipSectors}}
              <div class="imsc-ssl-row">
                <span class="imsc-ssl-label">{{label}}</span>
                <span class="imsc-ssl-max">{{zoneThreshold}}</span>
              </div>
              {{/each}}
            </div>

            {{!-- SVG Arc Compass with overlaid +/- controls --}}
            <div class="imsc-arc-compass-wrap">
                <svg class="imsc-arc-compass-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <path d="M 50.14 42.64 A 76 76 0 0 1 149.86 42.64 L 138.05 56.23 A 58 58 0 0 0 61.95 56.23 Z"
                          fill="{{#if captainCtx.shields.bow.over}}#44aaff{{else}}#00ff88{{/if}}" fill-opacity="{{captainCtx.shields.bow.pct}}"
                          stroke="{{#if captainCtx.shields.bow.over}}#44aaff{{else}}#00ff88{{/if}}" stroke-opacity="0.75" stroke-width="1"/>
                    <path d="M 157.36 50.14 A 76 76 0 0 1 157.36 149.86 L 143.77 138.05 A 58 58 0 0 0 143.77 61.95 Z"
                          fill="{{#if captainCtx.shields.starboard.over}}#44aaff{{else}}#00ff88{{/if}}" fill-opacity="{{captainCtx.shields.starboard.pct}}"
                          stroke="{{#if captainCtx.shields.starboard.over}}#44aaff{{else}}#00ff88{{/if}}" stroke-opacity="0.75" stroke-width="1"/>
                    <path d="M 149.86 157.36 A 76 76 0 0 1 50.14 157.36 L 61.95 143.77 A 58 58 0 0 0 138.05 143.77 Z"
                          fill="{{#if captainCtx.shields.stern.over}}#44aaff{{else}}#00ff88{{/if}}" fill-opacity="{{captainCtx.shields.stern.pct}}"
                          stroke="{{#if captainCtx.shields.stern.over}}#44aaff{{else}}#00ff88{{/if}}" stroke-opacity="0.75" stroke-width="1"/>
                    <path d="M 42.64 149.86 A 76 76 0 0 1 42.64 50.14 L 56.23 61.95 A 58 58 0 0 0 56.23 138.05 Z"
                          fill="{{#if captainCtx.shields.port.over}}#44aaff{{else}}#00ff88{{/if}}" fill-opacity="{{captainCtx.shields.port.pct}}"
                          stroke="{{#if captainCtx.shields.port.over}}#44aaff{{else}}#00ff88{{/if}}" stroke-opacity="0.75" stroke-width="1"/>
                    <circle cx="100" cy="100" r="36"
                            fill="#0a0f0a" fill-opacity="0.88"
                            stroke="#00ff88" stroke-opacity="0.22" stroke-width="1"/>
                    <polygon points="100,6 93,22 107,22"
                             fill="{{#if captainCtx.shields.bow.over}}#44aaff{{else}}#00ff88{{/if}}" fill-opacity="0.90"/>
                </svg>

                <span class="imsc-arc-val imsc-arc-val--bow{{#if captainCtx.shields.bow.over}} imsc-arc-val--over{{/if}}"         data-sector="bow"       data-field="shields">{{captainCtx.shields.bow.val}}</span>
                <span class="imsc-arc-val imsc-arc-val--starboard{{#if captainCtx.shields.starboard.over}} imsc-arc-val--over{{/if}}" data-sector="starboard" data-field="shields">{{captainCtx.shields.starboard.val}}</span>
                <span class="imsc-arc-val imsc-arc-val--stern{{#if captainCtx.shields.stern.over}} imsc-arc-val--over{{/if}}"       data-sector="stern"     data-field="shields">{{captainCtx.shields.stern.val}}</span>
                <span class="imsc-arc-val imsc-arc-val--port{{#if captainCtx.shields.port.over}} imsc-arc-val--over{{/if}}"         data-sector="port"      data-field="shields">{{captainCtx.shields.port.val}}</span>

                <div class="imsc-arc-center">
                    <div class="imsc-arc-pool-val">{{sys.shieldPool.current}}</div>
                    <span class="imsc-arc-dir">{{localize "IMSC.Sensors.PoolAvailable"}}</span>
                </div>
            </div>

            {{!-- Controls panel (right) --}}
            <div class="imsc-arc-hint-panel">
              <div class="imsc-ssl-head">{{localize "IMSC.Sensors.Controls"}}</div>
              <div class="imsc-arc-hint-row"><span class="imsc-arc-hint-key">Scroll</span><span class="imsc-arc-hint-val">Adjust</span></div>
              <div class="imsc-arc-hint-row"><span class="imsc-arc-hint-key">Left-Click</span><span class="imsc-arc-hint-val">+1</span></div>
              <div class="imsc-arc-hint-row"><span class="imsc-arc-hint-key">Right-Click</span><span class="imsc-arc-hint-val">−1</span></div>
              <button class="imsc-eng-btn imsc-controls-flux-btn" data-action="fluxToCharge"
                      data-tooltip="{{localize 'IMSC.Enginseer.FluxToChargeTooltip'}}"
                      {{#unless sys.shieldPool.current}}disabled{{/unless}}>
                  {{localize "IMSC.Enginseer.FluxToChargeShort"}}
              </button>
            </div>

        </div>
    </div>

    {{!-- ═══════ Conditions Panel ═══════ --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Captain.Conditions"}}</div>
        </div>
        <div class="list-content">
            {{#if captainCtx.hasAnyCondition}}
            {{#each captainCtx.conditionsList}}
            {{#if hasCondition}}
            <div class="list-row imsc-crit-row {{tierClass}}" data-loc-id="{{locId}}" data-tooltip='{{conditionEffect}}'>
                <div class="row-content">
                    <div class="list-name">
                        <span class="imsc-crit-location">{{locLabel}}</span>
                        <span class="imsc-crit-sep">  -  </span>
                        <span class="imsc-crit-name">{{conditionName}}</span>
                        {{#if jammedItemName}}
                        <span class="imsc-crit-meta"><i class="fa-solid fa-gun-slash"></i> {{jammedItemName}}</span>
                        {{/if}}
                    </div>
                    <div class="imsc-crit-tier-badge {{tierClass}}">{{tier}}</div>
                    <div class="list-controls">
                        <button type="button"
                                data-action="captainTriage"
                                data-loc-id="{{locId}}"
                                {{#unless canTriage}}disabled{{/unless}}
                                data-tooltip="{{triageName}}">
                            <i class="fa-solid fa-wrench"></i>
                        </button>
                    </div>
                </div>
            </div>
            {{/if}}
            {{/each}}
            {{else}}
            <div class="list-row">
                <div class="row-content">
                    <div class="list-name imsc-empty-label">
                        <i class="fa-solid fa-circle-check"></i>
                        {{localize "IMSC.Captain.NoConditions"}}
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    {{!-- ═══════ Captain Core Actions ═══════ --}}
    <div class="sheet-list imsc-captain-core-actions imsc-role-section">
        {{!-- Overlay when no core assigned --}}
        {{#unless captainCtx.hasCoreAssigned}}
        <div class="imsc-section-overlay imsc-section-overlay--taken">
            <div class="imsc-overlay-lock-indicator">
                <i class="fa-solid fa-lock fa-lg"></i>
                <span>{{localize "IMSC.Tooltip.NoPowerCore"}}</span>
            </div>
        </div>
        {{/unless}}
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Label.CoreActions"}}</div>
        </div>
        <div class="list-content">
            {{#each captainCtx.coreActions}}
            <div class="imsc-core-action-card">
                <button class="imsc-core-action-btn" data-action="captainCoreAction" data-core-action="{{id}}"
                        {{#unless canAfford}}disabled{{/unless}}
                        data-tooltip="{{descLocalized}}">
                    <i class="{{icon}}"></i>
                    <span>{{labelLocalized}}</span>
                    <small>{{localize "IMSC.Label.PowerCores"}}</small>
                </button>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- ═══════ Card Hand ═══════ --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">
                {{localize "IMSC.Captain.Hand"}}
                <span class="imsc-hand-count">({{captainCtx.handCount}}/6)</span>
            </div>
            {{#if captainCtx.handCapBonus}}
            <span class="imsc-hand-cap-note" data-tooltip="{{localize 'IMSC.Captain.HandCapNoteTooltip'}}">
                {{localize "IMSC.Captain.HandCapNote"}}
            </span>
            {{/if}}
        </div>
        <div class="list-content">
            {{#if captainCtx.hand.length}}
            <div class="imsc-captain-hand-grid">
            {{#each captainCtx.hand}}
            <div class="imsc-captain-card imsc-captain-card--{{category}}" data-card-id="{{cardId}}" draggable="true">
                <div class="imsc-captain-card-header">
                    <span class="imsc-captain-card-cat">{{catLabel}}</span>
                    {{#if targetRole}}
                    <span class="imsc-captain-card-target" data-tooltip="{{targetRoleLabel}}">
                        <i class="{{targetRoleIcon}}"></i>
                    </span>
                    {{/if}}
                    {{#if setsStance}}
                    <span class="imsc-captain-card-stance-dot"
                          data-tooltip="{{localize (concat 'IMSC.Captain.Stance.' setsStance)}}">
                        <i class="fa-solid fa-flag"></i>
                    </span>
                    {{/if}}
                </div>
                <div class="imsc-captain-card-name">
                    <i class="{{icon}}"></i> {{label}}
                </div>
                <div class="imsc-captain-card-desc">{{desc}}</div>
                {{#if setsStance}}
                <div class="imsc-captain-card-stance-footer">
                    <i class="fa-solid fa-flag"></i>
                    {{localize (concat "IMSC.Captain.Stance." setsStance)}}
                </div>
                {{/if}}
                <div class="imsc-captain-card-actions">
                    <a class="imsc-captain-card-action imsc-captain-card-action--reorder"
                       data-action="captainReorderCard" data-direction="up"
                       data-tooltip="{{localize 'IMSC.Captain.MoveCardUp'}}">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                    <a class="imsc-captain-card-action imsc-captain-card-action--reorder"
                       data-action="captainReorderCard" data-direction="down"
                       data-tooltip="{{localize 'IMSC.Captain.MoveCardDown'}}">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                    <a class="imsc-captain-card-action" data-action="captainPlayCard" data-card-id="{{cardId}}"
                       data-tooltip="{{localize 'IMSC.Captain.PlayCard'}}">
                        <i class="fa-solid fa-play"></i> {{localize "IMSC.Captain.PlayCard"}}
                    </a>
                    <a class="imsc-captain-card-action imsc-captain-card-action--discard"
                       data-action="captainDiscardCard" data-card-id="{{cardId}}"
                       data-tooltip="{{localize 'IMSC.Captain.DiscardCard'}}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                    {{#unless @root.captainCtx.mulliganUsed}}
                    <a class="imsc-captain-card-action imsc-captain-card-action--mulligan"
                       data-action="captainMulligan" data-card-id="{{cardId}}"
                       data-tooltip="{{localize 'IMSC.Captain.Mulligan'}}">
                        <i class="fa-solid fa-rotate"></i>
                    </a>
                    {{/unless}}
                </div>
            </div>
            {{/each}}
            </div>
            {{else}}
            <div class="list-row">
                <div class="row-content">
                    <div class="list-name imsc-empty-label">
                        {{localize "IMSC.Captain.HandEmpty"}}
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
        {{!-- Deck / Discard footer --}}
        <div class="list-footer row-content imsc-deck-footer">
            <div class="imsc-deck-footer-piles">
                <span class="imsc-pile-count">
                    <i class="fa-solid fa-layer-group"></i>
                    {{localize "IMSC.Captain.DrawPile"}}: {{captainCtx.drawPileCount}}
                </span>
                <span class="imsc-pile-count">
                    <i class="fa-solid fa-trash-can"></i>
                    {{localize "IMSC.Captain.DiscardPile"}}: {{captainCtx.discardPileCount}}
                </span>
            </div>
            <div class="imsc-deck-footer-actions">
                <button type="button"
                        data-action="captainFullRedraw"
                        class="imsc-full-redraw-btn"
                        {{#unless captainCtx.canFullRedraw}}disabled{{/unless}}
                        data-tooltip="{{localize 'IMSC.Captain.FullRedrawHint'}}">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    {{localize "IMSC.Captain.FullRedraw"}}
                </button>
                {{#if captainCtx.canDraw}}
                <span class="imsc-draw-row">
                    <input type="number" class="imsc-draw-count-input" min="1" max="{{captainCtx.drawCount}}"
                           value="{{captainCtx.drawCount}}" data-max-draw="{{captainCtx.drawCount}}">
                    <button type="button" data-action="captainDraw"
                            data-tooltip="{{localize 'IMSC.Captain.DrawCard'}} ({{localize 'IMSC.Captain.DrawMax'}}: {{captainCtx.drawCount}})">
                        <i class="fa-solid fa-hand"></i> {{localize "IMSC.Captain.DrawCard"}}
                    </button>
                </span>
                {{/if}}
            </div>
        </div>
    </div>

    {{!-- ═══════ Active Orders (played cards this round) ═══════ --}}
    {{#if captainCtx.hasPlayedCards}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">
                <i class="fa-solid fa-check-double"></i>
                {{localize "IMSC.Captain.ActiveOrders"}}
            </div>
        </div>
        <div class="list-content">
            <div class="imsc-played-cards-row">
                {{#each captainCtx.playedCards}}
                <span class="imsc-played-chip {{catClass}}">{{label}}</span>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}

    {{/if}}{{!-- end captain/GM gate --}}

    {{> 'modules/impmal-shipcombat/templates/actor/partials/complete-turn.hbs' tabRoleId="captain" turnDone=(lookup @root.sys.turnDone "captain")}}

</section>
{{!-- ship-captain.hbs – Captain's station tab --}}

