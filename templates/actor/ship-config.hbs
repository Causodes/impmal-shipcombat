<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    {{!-- Crew Size --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name imsc-inline-field">
                {{localize "IMSC.Label.ActiveRoles"}}
                {{#if isOwner}}
                <select data-slot-count="system.crewSize" class="imsc-crewsize-select">
                    {{#each crewSizeOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>
                    {{/each}}
                </select>
                {{else}}
                <span>{{crewSize}}</span>
                {{/if}}
            </div>
        </div>
    </div>

    {{!-- Weapon Battery Slot Counts --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Label.WeaponSlots"}}</div>
        </div>
        <div class="list-content">
            <div class="imsc-weapon-slot-grid">
                {{#each weaponSectionsAll}}
                <div class="imsc-weapon-slot-cell">
                    <div class="imsc-weapon-slot-label">{{labelLocalized}}</div>
                    {{#if @root.isOwner}}
                    <input type="number" min="0" value="{{slotCount}}" data-slot-count="system.weaponSlots.{{id}}" class="imsc-slot-input imsc-weapon-slot-input">
                    {{else}}
                    <span class="imsc-weapon-slot-val">{{slotCount}}</span>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
    </div>

    {{!-- Ordnance Actor Templates (Torpedo / Strike Craft actors) --}}
    <div class="imsc-section-grid">
        {{!-- Torpedo Actors --}}
        <div class="sheet-list vehicle-actors droppable" data-ordnance-drop="torpedo">
            <div class="list-header row-content">
                <div class="list-name">{{localize "IMSC.Label.TorpedoActors"}}</div>
                <div class="list-controls"></div>
            </div>
            <div class="list-content">
                {{#each ordnanceActors.torpedo}}
                <div class="list-row" data-ordnance-id="{{id}}" data-ordnance-slot="torpedo">
                    <div class="row-content">
                        <div class="list-name">
                            {{#if img}}<img src="{{img}}">{{/if}}
                            <a class="label" data-action="openOrdnanceActor">{{name}}</a>
                        </div>
                        <div class="list-controls">
                            {{#if @root.isOwner}}<a class="list-control" data-action="removeOrdnanceActor"><i class="fa-solid fa-xmark"></i></a>{{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
                {{#if @root.isOwner}}
                <div class="droppable" data-ordnance-drop="torpedo" data-tooltip="{{localize 'IMSC.Hint.DropOrdnanceActor'}}"><i class="fa-solid fa-plus"></i></div>
                {{/if}}
            </div>
        </div>

        {{!-- Strike Craft Actors --}}
        <div class="sheet-list vehicle-actors droppable" data-ordnance-drop="strikeCraft">
            <div class="list-header row-content">
                <div class="list-name">{{localize "IMSC.Label.StrikeCraftActors"}}</div>
                <div class="list-controls"></div>
            </div>
            <div class="list-content">
                {{#each ordnanceActors.strikeCraft}}
                <div class="list-row" data-ordnance-id="{{id}}" data-ordnance-slot="strikeCraft">
                    <div class="row-content">
                        <div class="list-name">
                            {{#if img}}<img src="{{img}}">{{/if}}
                            <a class="label" data-action="openOrdnanceActor">{{name}}</a>
                        </div>
                        <div class="list-controls">
                            {{#if @root.isOwner}}<a class="list-control" data-action="removeOrdnanceActor"><i class="fa-solid fa-xmark"></i></a>{{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
                {{#if @root.isOwner}}
                <div class="droppable" data-ordnance-drop="strikeCraft" data-tooltip="{{localize 'IMSC.Hint.DropOrdnanceActor'}}"><i class="fa-solid fa-plus"></i></div>
                {{/if}}
            </div>
        </div>
    </div>

    {{!-- Component Inventory --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Label.ComponentInventory"}}</div>
            <div class="list-controls">
                {{#if isGM}}<a class="list-control" data-action="addToInventory" data-tooltip="{{localize 'IMSC.Action.AddComponent'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
            </div>
        </div>
        <div class="list-content">
            {{#if componentInventoryBySlot.length}}
            {{#each componentInventoryBySlot}}
            <div class="imsc-inv-group">
                <div class="imsc-inv-group-header">{{slotLabel}}</div>
                {{#each items}}
                <div class="list-row" data-id="{{id}}" data-uuid="{{uuid}}">
                    <div class="row-content">
                        <div class="list-name">
                            <img src="{{img}}">
                            <a class="label" data-action="openItem">{{name}}</a>
                            {{#unless equipped}}<span class="imsc-muted imsc-config-uninstalled"> &bull; {{localize "IMSC.Label.Uninstalled"}}</span>{{/unless}}
                        </div>
                        <div class="list-controls">
                            {{#if @root.isGM}}<a class="list-control" data-action="deleteEmbedded"><i class="fa-solid fa-xmark"></i></a>{{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/each}}
            {{else}}
            <div class="list-row">
                <div class="row-content imsc-muted" style="padding: 6px 8px;">{{localize "IMSC.Label.NoComponents"}}</div>
            </div>
            {{/if}}
        </div>
    </div>

</section>
