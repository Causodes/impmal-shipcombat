<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    {{!-- Role claim prompt --}}
    {{#with (lookup roles "enginseer")}}
    {{#unless isMyRole}}
        {{#unless @root.isGM}}
        <div class="sheet-list">
            <div class="list-content">
                <div class="list-row">
                    <div class="row-content">
                        <div class="list-name">{{localize "IMSC.Prompt.ClaimRole"}}</div>
                        <div class="list-controls">
                            <button data-action="claimRole" data-role-id="enginseer">
                                <i class="fa-solid fa-gears"></i> {{localize "IMSC.Role.Enginseer"}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/unless}}
    {{/unless}}
    {{/with}}

    {{!-- ═══════ Captain Boost Banner ═══════ --}}
    {{#if engineerCtx.captainBoosts.length}}
    <div class="imsc-captain-boost-bar">
        <span class="imsc-captain-boost-bar-label"><i class="fa-solid fa-flag"></i> {{localize "IMSC.Captain.ActiveOrdersShort"}}:</span>
        {{#each engineerCtx.captainBoosts}}
        <span class="imsc-captain-boost-chip">{{label}}</span>
        {{/each}}
    </div>
    {{/if}}

    {{!-- ═══════ Always-visible: Reactor Status (sticky) ═══════ --}}
    <div class="sheet-list imsc-role-status-bar">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Enginseer.StatusTitle"}}</div>
            {{#with (lookup roles "enginseer")}}
            {{> "modules/impmal-shipcombat/templates/actor/partials/payload-status-badge.hbs"
                payloadId=payloadId payloadLabel=payloadLabel payloadDesc=payloadDesc}}
            {{/with}}
        </div>
        <div class="list-content">
            <div class="imsc-role-status-panel">
                {{!-- Heat bar --}}
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Resource.Heat"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--heat">
                        <div class="imsc-resource-bar-fill-cover" style="width: calc(100% - {{engineerCtx.heatPct}}%)"></div>
                    </div>
                    <span class="imsc-resource-bar-value" style="color: {{engineerCtx.heatColor}}">{{engineerCtx.heat}}/{{engineerCtx.heatMax}}</span>
                </div>
                {{!-- Auxiliary Power bar --}}
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Enginseer.CoreBank"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--plasma">
                        <div class="imsc-resource-bar-fill" style="width: {{engineerCtx.plasmaPct}}%"></div>
                    </div>
                    <span class="imsc-resource-bar-value imsc-resource-bar-value--plasma">{{engineerCtx.auxiliaryPower}}/{{engineerCtx.auxPowerCapacity}}</span>
                </div>
            </div>
        </div>
    </div>

    {{!-- ═══════ 1. Core Distribution ═══════ --}}
    <div class="sheet-list imsc-role-section">

        {{!-- Overlay: hidden when this section is already selected --}}
        {{#unless engineerCtx.coresSelected}}
        <div class="imsc-section-overlay{{#if (imscOr engineerCtx.ventLocked (imscEq engineerCtx.actionsRemaining 0))}} imsc-section-overlay--taken{{/if}}">
            {{#if engineerCtx.ventLocked}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-lock fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.VentLockedDesc"}}</span>
                </div>
            {{else if (imscEq engineerCtx.actionsRemaining 0)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-ban fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.ActionTakenDesc"}}</span>
                </div>
            {{else}}
            <button class="imsc-section-overlay-btn" data-action="selectAction" data-action-type="cores">
                {{localize "IMSC.Enginseer.CoreDistribution"}}
            </button>
            {{/if}}
        </div>
        {{/unless}}

        <div class="list-header row-content">
            <div class="list-name">
                {{localize "IMSC.Enginseer.CoreDistribution"}}
                {{#if engineerCtx.ventLocked}}
                <span class="imsc-muted">  -  {{localize "IMSC.Enginseer.VentLocked"}}</span>
                {{/if}}
            </div>
        </div>
        <div class="list-content imsc-helm-panel">

            {{!-- Power core pips --}}
            <div>
                <p class="imsc-helm-section-label" style="text-align:center; margin:0 0 0.2rem">{{localize "IMSC.Label.PowerCores"}}</p>
                <div class="imsc-core-pips" style="justify-content:center">
                    {{#each powerCorePips}}
                        <div class="imsc-core-pip imsc-core-pip--{{state}}" data-pip-state="{{state}}"></div>
                    {{/each}}
                </div>
            </div>
            {{#if engineerCtx.coresExhausted}}
                <div style="text-align:center"><span class="imsc-muted" style="font-size:0.7rem">{{localize "IMSC.Enginseer.CoreExhausted"}}</span></div>
            {{/if}}

            {{!-- Overclock + Dispatch --}}
            <div class="imsc-core-action-row">
                <button class="imsc-eng-btn imsc-overclock-btn" data-action="overclock"
                        {{#unless engineerCtx.canOverclock}}disabled{{/unless}}
                        data-tooltip="{{localize 'IMSC.Tooltip.Overclock'}} ({{engineerCtx.overclockTier}} {{engineerCtx.overclockModifier}})">
                    {{localize "IMSC.Action.Overclock"}}
                </button>
                <button class="imsc-eng-btn imsc-dispatch-btn" data-action="dispatchCores"
                        {{#unless engineerCtx.hasStaged}}disabled{{/unless}}
                        data-tooltip="{{localize 'IMSC.Tooltip.DispatchCores'}}">
                    {{localize "IMSC.Enginseer.DispatchCores"}}
                </button>
            </div>

            {{!-- Allocation table: Shield + per-role rows in a unified list --}}
            <div class="imsc-core-alloc-table">
                {{!-- Shield Commitment row --}}
                <div class="imsc-core-alloc-row imsc-core-alloc-row--shield">
                    <span class="imsc-core-alloc-name">{{localize "IMSC.Enginseer.ShieldCommitment"}}</span>
                    <span class="imsc-core-alloc-detail imsc-muted">{{localize "IMSC.Enginseer.ProjectedShieldPool"}}: <strong class="imsc-shieldpool-active">{{engineerCtx.projectedShieldPool}}</strong> / {{engineerCtx.maxVoidFlux}}</span>
                    <div class="imsc-core-alloc-ctrl">
                        <span class="imsc-core-flux-label imsc-muted">{{engineerCtx.shieldStrengthPerCore}} {{localize "IMSC.Enginseer.FluxPerCore"}}</span>
                        <button class="imsc-alloc-btn" data-action="uncommitShieldCore">&minus;</button>
                        <span class="imsc-core-alloc-count">{{engineerCtx.stagedShieldCores}}</span>
                        <button class="imsc-alloc-btn" data-action="commitShieldCore">+</button>
                    </div>
                </div>

                {{!-- Auxiliary Power row --}}
                <div class="imsc-core-alloc-row imsc-core-alloc-row--aux">
                    <span class="imsc-core-alloc-name">{{localize "IMSC.Enginseer.AuxPowerAlloc"}}</span>
                    <span class="imsc-core-alloc-detail imsc-muted">{{localize "IMSC.Enginseer.ProjectedAuxPower"}}: <strong>+{{engineerCtx.projectedAuxGain}}</strong></span>
                    <div class="imsc-core-alloc-ctrl">
                        <span class="imsc-core-flux-label imsc-muted">{{engineerCtx.reserveMultiplier}} {{localize "IMSC.Enginseer.AuxPerCore"}}</span>
                        <button class="imsc-alloc-btn" data-action="uncommitAuxCore">&minus;</button>
                        <span class="imsc-core-alloc-count">{{engineerCtx.stagedAuxCores}}</span>
                        <button class="imsc-alloc-btn" data-action="commitAuxCore">+</button>
                    </div>
                </div>

                {{!-- Per-role rows --}}
                {{#each roles}}
                {{#unless (imscEq id "enginseer")}}
                <div class="imsc-core-alloc-row">
                    <span class="imsc-core-alloc-name">{{labelLocalized}}</span>
                    <span class="imsc-core-alloc-detail imsc-muted">{{#if assignedActor}}{{assignedActor.name}}{{else}}&mdash;{{/if}}</span>
                    <div class="imsc-core-alloc-ctrl">
                        {{#if hasCoreAssigned}}
                            <span class="imsc-core-btn--assigned"><i class="fa-solid fa-check"></i></span>
                        {{else}}
                            <a class="imsc-core-btn {{#if hasCoreStaged}}imsc-core-btn--staged{{/if}}"
                               data-action="toggleCore" data-role-id="{{id}}"
                               data-tooltip="{{localize 'IMSC.Tooltip.ToggleCore'}}">
                                <i class="fa-solid fa-bolt"></i>
                            </a>
                        {{/if}}
                    </div>
                </div>
                {{/unless}}
                {{/each}}
            </div>

            {{!-- Emergency Vent --}}
            <div style="text-align:center; margin-top:0.25rem">
                {{#if engineerCtx.ventPending}}
                <button class="imsc-eng-btn imsc-action-danger imsc-action-vent-fired" disabled style="max-width:20rem; margin:0 auto">
                    {{localize "IMSC.Enginseer.VentFired"}}
                </button>
                {{else}}
                <button class="imsc-eng-btn imsc-action-danger" data-action="emergencyVent"
                        data-tooltip="{{localize 'IMSC.Enginseer.EmergencyVentDesc'}}" style="max-width:20rem; margin:0 auto"
                        {{#unless engineerCtx.heat}}disabled{{/unless}}>
                    {{localize "IMSC.Enginseer.EmergencyVent"}}
                </button>
                {{/if}}
            </div>

        </div>
    </div>

    {{!-- ═══════ 2. Heat Management ═══════ --}}
    <div class="sheet-list imsc-role-section">

        {{#unless engineerCtx.heatSelected}}
        <div class="imsc-section-overlay{{#if (imscOr (imscNot engineerCtx.hasBankedCores) (imscEq engineerCtx.actionsRemaining 0))}} imsc-section-overlay--taken{{/if}}">
            {{#if (imscNot engineerCtx.hasBankedCores)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-lock fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.RequiresBankedCore"}}</span>
                </div>
            {{else if (imscEq engineerCtx.actionsRemaining 0)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-ban fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.ActionTakenDesc"}}</span>
                </div>
            {{else}}
            <button class="imsc-section-overlay-btn" data-action="selectAction" data-action-type="heat">
                {{localize "IMSC.Enginseer.HeatManagement"}}
            </button>
            {{/if}}
        </div>
        {{/unless}}

        <div class="list-header row-content">
            <div class="list-name">
                {{localize "IMSC.Enginseer.HeatManagement"}}
            </div>
        </div>
        <div class="list-content">
            <div class="imsc-eng-action-row">
                <p class="imsc-eng-action-desc">{{localize "IMSC.Enginseer.ManageHeatDesc"}}</p>
                <div class="imsc-eng-action-ctrl">
                    <button class="imsc-alloc-btn" data-action="adjustHeatCores" data-delta="-1"
                            {{#unless engineerCtx.hasBankedCores}}disabled{{/unless}}>&minus;</button>
                    <span class="imsc-core-alloc-count">{{engineerCtx.heatCoresStaged}}</span>
                    <button class="imsc-alloc-btn" data-action="adjustHeatCores" data-delta="1"
                            {{#unless engineerCtx.hasBankedCores}}disabled{{/unless}}>+</button>
                </div>
                <button type="button" class="imsc-eng-confirm" data-action="manageHeat"
                        {{#unless engineerCtx.hasBankedCores}}disabled{{/unless}}>
                    {{localize "IMSC.Enginseer.Execute"}}
                </button>
            </div>
        </div>
    </div>

    {{!-- ═══════ 3. Fire Suppression ═══════ --}}
    <div class="sheet-list imsc-role-section">

        {{#unless engineerCtx.fireSelected}}
        <div class="imsc-section-overlay{{#if (imscOr (imscNot engineerCtx.hasBankedCores) (imscEq engineerCtx.actionsRemaining 0))}} imsc-section-overlay--taken{{/if}}">
            {{#if (imscNot engineerCtx.hasBankedCores)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-lock fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.RequiresBankedCore"}}</span>
                </div>
            {{else if (imscEq engineerCtx.actionsRemaining 0)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-ban fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.ActionTakenDesc"}}</span>
                </div>
            {{else}}
            <button class="imsc-section-overlay-btn" data-action="selectAction" data-action-type="fire">
                {{localize "IMSC.Enginseer.FireSuppression"}}
            </button>
            {{/if}}
        </div>
        {{/unless}}

        <div class="list-header row-content">
            <div class="list-name">
                {{localize "IMSC.Enginseer.FireSuppression"}}
            </div>
        </div>
        <div class="list-content">
            <div class="imsc-eng-action-row">
                <p class="imsc-eng-action-desc">{{localize "IMSC.Enginseer.SuppressFireDesc"}}</p>
                <div class="imsc-eng-action-ctrl">
                    <button class="imsc-alloc-btn" data-action="adjustFireCores" data-delta="-1"
                            {{#if (imscOr (imscNot engineerCtx.hasInternalFire) (imscNot engineerCtx.hasBankedCores))}}disabled{{/if}}>&minus;</button>
                    <span class="imsc-core-alloc-count">{{engineerCtx.fireCoresStaged}}</span>
                    <button class="imsc-alloc-btn" data-action="adjustFireCores" data-delta="1"
                            {{#if (imscOr (imscNot engineerCtx.hasInternalFire) (imscNot engineerCtx.hasBankedCores))}}disabled{{/if}}>+</button>
                </div>
                <button type="button" class="imsc-eng-confirm" data-action="suppressFire"
                        {{#if (imscOr (imscNot engineerCtx.hasInternalFire) (imscNot engineerCtx.hasBankedCores))}}disabled{{/if}}>
                    {{localize "IMSC.Enginseer.Execute"}}
                </button>
            </div>
        </div>
    </div>

    {{!-- ═══════ 4. Hull Repair ═══════ --}}
    <div class="sheet-list imsc-role-section">

        {{#unless engineerCtx.repairSelected}}
        <div class="imsc-section-overlay{{#if (imscOr (imscNot engineerCtx.canRepairHull) (imscEq engineerCtx.actionsRemaining 0))}} imsc-section-overlay--taken{{/if}}">
            {{#if engineerCtx.hasInternalFire}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-fire fa-lg"></i>
                    <span>{{localize "IMSC.Warning.RepairBlockedByFire"}}</span>
                </div>
            {{else if (imscNot engineerCtx.hasBankedCores)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-lock fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.RequiresBankedCore"}}</span>
                </div>
            {{else if (imscEq engineerCtx.hull 0)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-check fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.HullFull"}}</span>
                </div>
            {{else if (imscEq engineerCtx.actionsRemaining 0)}}
                <div class="imsc-overlay-lock-indicator">
                    <i class="fa-solid fa-ban fa-lg"></i>
                    <span>{{localize "IMSC.Enginseer.ActionTakenDesc"}}</span>
                </div>
            {{else}}
            <button class="imsc-section-overlay-btn" data-action="selectAction" data-action-type="repair">
                {{localize "IMSC.Enginseer.HullRepair"}}
            </button>
            {{/if}}
        </div>
        {{/unless}}

        <div class="list-header row-content">
            <div class="list-name">
                {{localize "IMSC.Enginseer.HullRepair"}}
            </div>
            <div class="imsc-hull-status">
                <span class="imsc-hull-value">{{engineerCtx.hull}} / {{engineerCtx.hullMax}}</span>
                <div class="imsc-hull-bar-track">
                    <div class="imsc-hull-bar-fill" style="width: {{engineerCtx.hullPct}}%"></div>
                </div>
            </div>
        </div>
        <div class="list-content">
            <div class="imsc-eng-action-row">
                <p class="imsc-eng-action-desc">{{localize "IMSC.Enginseer.HullRepairDesc"}}</p>
                <div class="imsc-eng-action-ctrl">
                    <button class="imsc-alloc-btn" data-action="adjustRepairPlasma" data-delta="-1"
                            {{#unless engineerCtx.canRepairHull}}disabled{{/unless}}>&minus;</button>
                    <span class="imsc-core-alloc-count">{{engineerCtx.repairPlasmaStaged}}</span>
                    <button class="imsc-alloc-btn" data-action="adjustRepairPlasma" data-delta="1"
                            {{#unless engineerCtx.canRepairHull}}disabled{{/unless}}>+</button>
                </div>
                <button type="button" class="imsc-eng-confirm" data-action="repairHull"
                        {{#unless engineerCtx.canRepairHull}}disabled{{/unless}}>
                    {{localize "IMSC.Enginseer.Execute"}}
                </button>
            </div>
        </div>
    </div>

    {{> 'modules/impmal-shipcombat/templates/actor/partials/complete-turn.hbs' tabRoleId="enginseer" turnDone=(lookup @root.sys.turnDone "enginseer")}}

</section>
