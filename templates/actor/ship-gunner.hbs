<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    {{#with (lookup roles "gunner")}}
    {{#unless isMyRole}}
        {{#unless @root.isGM}}
        <div class="sheet-list">
            <div class="list-content">
                <div class="list-row">
                    <div class="row-content">
                        <div class="list-name">{{localize "IMSC.Prompt.ClaimRole"}}</div>
                        <div class="list-controls">
                            <button data-action="claimRole" data-role-id="gunner">
                                <i class="fa-solid fa-crosshairs"></i> {{localize "IMSC.Role.Gunner"}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/unless}}
    {{/unless}}
    {{/with}}

    {{!-- ═══════ Captain Boost Banner ═══════ --}}
    {{#if gunnerCtx.captainBoosts.length}}
    <div class="imsc-captain-boost-bar">
        <span class="imsc-captain-boost-bar-label"><i class="fa-solid fa-flag"></i> {{localize "IMSC.Captain.ActiveOrdersShort"}}:</span>
        {{#each gunnerCtx.captainBoosts}}
        <span class="imsc-captain-boost-chip">{{label}}</span>
        {{/each}}
    </div>
    {{/if}}

    {{!-- ═══════ Docked Resource Bar ═══════ --}}
    <div class="sheet-list imsc-role-status-bar">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Gunner.StatusTitle"}}</div>
            {{#with (lookup roles "gunner")}}
            {{> "modules/impmal-shipcombat/templates/actor/partials/payload-status-badge.hbs"
                payloadId=payloadId payloadLabel=payloadLabel payloadDesc=payloadDesc}}
            {{> "modules/impmal-shipcombat/templates/actor/partials/core-status-banner.hbs"
                coreCount=coreCount coreActionsPlayedLabels=@root.gunnerCtx.coreActionsPlayedLabels hasCoreStaged=hasCoreStaged}}
            {{/with}}
        </div>
        <div class="list-content">
            <div class="imsc-role-status-panel">
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Gunner.Ammo"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--plasma">
                        <div class="imsc-resource-bar-fill imsc-bar-ammo" style="width: {{gunnerCtx.ammoPct}}%"></div>
                    </div>
                    <span class="imsc-resource-bar-value" style="color: #e67e22">{{gunnerCtx.ammo}}/{{gunnerCtx.ammoMax}}</span>
                </div>
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Gunner.Heat"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--heat">
                        <div class="imsc-resource-bar-fill-cover" style="width: calc(100% - {{gunnerCtx.heatPct}}%)"></div>
                    </div>
                    <span class="imsc-resource-bar-value" style="color: {{gunnerCtx.heatColor}}">{{gunnerCtx.heat}}/{{gunnerCtx.heatMax}}</span>
                </div>
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Sensors.PowerTrack"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--plasma">
                        <div class="imsc-resource-bar-fill imsc-bar-charge" style="width: {{gunnerCtx.powerPct}}%"></div>
                    </div>
                    <span class="imsc-resource-bar-value" style="color: #7ec8e3">{{gunnerCtx.power}}/{{gunnerCtx.powerMax}}</span>
                </div>
            </div>
        </div>
    </div>

    {{!-- ═══════ Ordnance SL Allocation ═══════ --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Gunner.OrdnanceAllocation"}}</div>
        </div>
        <div class="list-content">
            <div class="imsc-helm-stats">
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Gunner.OrdnanceSLTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Gunner.OrdnanceSL"}}</span>
                    {{#if gunnerCtx.ordnanceRolled}}
                        <span class="imsc-helm-stat-value imsc-sl-badge">{{gunnerCtx.remainingSL}}</span>
                    {{else}}
                        <button class="imsc-roll-piloting-btn" data-action="rollOrdnance">
                            <i class="fa-solid fa-dice"></i> {{localize "IMSC.Gunner.RollOrdnance"}}
                        </button>
                    {{/if}}
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Gunner.AccuracyTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Gunner.Accuracy"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocGunnerSL" data-stat="accuracy" data-delta="-1"
                                {{#if gunnerCtx.allocLocked}}disabled{{/if}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{gunnerCtx.allocAccuracy}}</span>
                        <button class="imsc-alloc-btn" data-action="allocGunnerSL" data-stat="accuracy" data-delta="1"
                                {{#if gunnerCtx.allocLocked}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Gunner.PenetrationTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Gunner.Penetration"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocGunnerSL" data-stat="penetration" data-delta="-1"
                                {{#if gunnerCtx.allocLocked}}disabled{{/if}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{gunnerCtx.allocPenetration}}</span>
                        <button class="imsc-alloc-btn" data-action="allocGunnerSL" data-stat="penetration" data-delta="1"
                                {{#if gunnerCtx.allocLocked}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Gunner.FirepowerTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Gunner.Firepower"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocGunnerSL" data-stat="firepower" data-delta="-1"
                                {{#if gunnerCtx.allocLocked}}disabled{{/if}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{gunnerCtx.allocFirepower}}</span>
                        <button class="imsc-alloc-btn" data-action="allocGunnerSL" data-stat="firepower" data-delta="1"
                                {{#if gunnerCtx.allocLocked}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- ═══════ Gunner Core Actions ═══════ --}}
    <div class="sheet-list imsc-gunner-core-actions imsc-role-section">
        {{!-- Overlay: only "No Power Core" when none available --}}
        {{#unless gunnerCtx.hasCoreAssigned}}
        <div class="imsc-section-overlay imsc-section-overlay--taken">
            <div class="imsc-overlay-lock-indicator">
                <i class="fa-solid fa-lock fa-lg"></i>
                <span>{{localize "IMSC.Tooltip.NoPowerCore"}}</span>
            </div>
        </div>
        {{/unless}}

        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Label.CoreActions"}}</div>
        </div>
        <div class="list-content">
            {{#each gunnerCtx.coreActions}}
            <div class="imsc-core-action-card">
                <button class="imsc-core-action-btn" data-action="gunnerCoreAction" data-core-action="{{id}}"
                        {{#unless canAfford}}disabled{{/unless}}
                        data-tooltip="{{descLocalized}}">
                    <i class="{{icon}}"></i>
                    <span>{{labelLocalized}}</span>
                    <small>{{localize "IMSC.Label.PowerCores"}}</small>
                </button>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- ═══════ Weapon Batteries (by position) ═══════ --}}
    {{#each weaponSections}}
    <div class="sheet-list imsc-weapon-battery-section">
        <div class="list-header row-content">
            <div class="list-name">{{this.labelLocalized}}</div>
        </div>
        <div class="list-content">
            {{#if this.items.length}}
                {{#each this.items}}
                <div class="imsc-battery-card" data-uuid="{{this.uuid}}" data-id="{{this.id}}" data-weapon-arc="{{this.id}}" data-weapon-type="{{this.system.resourceType}}">

                    {{!-- ─── Header (shared) ─── --}}
                    <div class="imsc-battery-header">
                        <img src="{{this.img}}" class="imsc-battery-icon">
                        <span class="imsc-battery-name">{{this.name}}</span>
                        <a class="list-control imsc-pin-arc" data-pin-weapon="{{this.id}}"
                           data-tooltip="{{localize 'IMSC.Gunner.PinArc'}}"><i class="fa-solid fa-thumbtack"></i></a>
                    </div>

                    {{!-- ─── Traits (shared) ─── --}}
                    {{#if this.traitTags.length}}
                    <div class="imsc-battery-traits">
                        {{#each this.traitTags}}
                        <span class="imsc-trait-tag imsc-trait--{{this.key}}" data-tooltip="{{this.tooltip}}" data-tooltip-direction="DOWN">
                            {{this.label}}{{#if this.value}} ({{this.value}}){{/if}}
                        </span>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- ─── Misconfigured warning ─── --}}
                    {{#if this.isMisconfigured}}
                    <div class="imsc-battery-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        {{localize "IMSC.Warning.WeaponNotConfiguredShort"}}
                    </div>
                    {{/if}}

                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{!-- MACRO CANNON  -  interactive tier picker          --}}
                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{#if (imscEq this.system.resourceType "ammo")}}
                    <div class="imsc-battery-body imsc-battery--macro">
                        {{!-- Static stats + dynamic selection display --}}
                        <div class="imsc-battery-stats-row">
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Damage"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.damage}}</span>
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Range"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.range}}</span>
                            </div>
                            <div class="imsc-battery-stat" data-macro-stat-display="ammo">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Gunner.ReadyRounds"}}</span>
                                <span class="imsc-battery-stat-value imsc-macro-stat-ammo" style="color:#e67e22">-</span>
                            </div>
                            <div class="imsc-battery-stat" data-macro-stat-display="hit">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Gunner.HitMod"}}</span>
                                <span class="imsc-battery-stat-value imsc-macro-stat-hit">-</span>
                            </div>
                            <div class="imsc-battery-stat" data-macro-stat-display="salvo">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Gunner.Salvo"}}</span>
                                <span class="imsc-battery-stat-value imsc-macro-stat-salvo">-</span>
                            </div>
                        </div>
                        {{!-- Tier picker  -  click to select fire mode --}}
                        <div class="imsc-macro-tier-picker" data-weapon-id="{{this.id}}">
                            {{#each this.fireTiers}}
                            <div class="imsc-macro-tier-pip {{#unless this.canAfford}}imsc-tier-dimmed{{/unless}} {{#if this.isExclusive}}imsc-tier-exclusive{{/if}}"
                                 data-tier-id="{{this.id}}"
                                 data-tier-ammo="{{this.ammo}}"
                                 data-tier-hit="{{this.hitMod}}"
                                 data-tier-salvo="{{this.salvoSize}}"
                                 data-can-afford="{{this.canAfford}}"
                                 {{#if this.desc}}data-tooltip="{{this.desc}}" data-tooltip-direction="DOWN"{{/if}}>
                                <span class="imsc-macro-pip-label">{{this.label}}</span>
                                <div class="imsc-macro-pip-detail">
                                    <span class="imsc-macro-pip-ammo">{{this.ammo}} rds</span>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        {{!-- Fire button  -  enabled once a tier is selected --}}
                        <div class="imsc-battery-actions">
                            <button class="imsc-battery-fire-btn imsc-fire--macro" data-action="fireWeapon"
                                    data-weapon-id="{{this.id}}" data-fire-mode="" disabled>
                                <i class="fa-solid fa-crosshairs"></i>
                                <span class="imsc-macro-fire-label">{{localize "IMSC.Gunner.SelectFireMode"}}</span>
                            </button>
                        </div>
                    </div>
                    {{/if}}

                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{!-- PLASMA CANNON  -  unlimited fire, heat per shot  --}}
                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{#if (imscEq this.system.resourceType "heat")}}
                    <div class="imsc-battery-body imsc-battery--plasma">
                        <div class="imsc-battery-stats-row">
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Damage"}}</span>
                                <span class="imsc-battery-stat-value imsc-plasma-dmg">{{this.plasma.totalDamage}}</span>
                                {{#if this.plasma.dmgBonus}}
                                <span class="imsc-fp-note">+{{this.plasma.dmgBonus}} FP</span>
                                {{/if}}
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Range"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.range}}</span>
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Gunner.HeatPerShot"}}</span>
                                <span class="imsc-battery-stat-value imsc-val-heat">+{{this.plasma.heatPerShot}}</span>
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Gunner.HeatPerVolley"}}</span>
                                <span class="imsc-battery-stat-value imsc-val-heat">+{{this.plasma.heatPerVolley}}</span>
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Gunner.Salvo"}}</span>
                                <span class="imsc-battery-stat-value">{{this.plasma.salvoSize}}</span>
                            </div>
                        </div>
                        <div class="imsc-plasma-shots">
                            <span class="imsc-plasma-remaining">
                                <i class="fa-solid fa-fire"></i>
                                {{this.plasma.shotsRemaining}} {{localize "IMSC.Gunner.ShotsRemaining"}}
                            </span>
                        </div>
                        <div class="imsc-battery-actions">
                            {{#if this.plasma.canFire}}
                            <button class="imsc-battery-fire-btn imsc-fire--plasma" data-action="fireWeapon" data-fire-mode="plasmaShot" data-weapon-id="{{this.id}}">
                                <i class="fa-solid fa-fire"></i> {{localize "IMSC.Gunner.PlasmaShot"}}
                            </button>
                            {{else}}
                            <span class="imsc-fire-blocked"><i class="fa-solid fa-temperature-full"></i> {{localize "IMSC.Warning.HeatMaxedShort"}}</span>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}

                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{!-- LANCE BATTERY  -  charge meter, damage tiers     --}}
                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{#if (imscEq this.system.resourceType "power")}}
                    <div class="imsc-battery-body imsc-battery--lance">
                        <div class="imsc-battery-stats-row">
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Damage"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.damage}}</span>
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Range"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.range}}</span>
                            </div>
                        </div>
                        {{!-- Charge meter --}}
                        <div class="imsc-lance-charge-meter">
                                <span class="imsc-lance-charge-label">{{localize "IMSC.Sensors.PowerTrack"}}</span>
                            <div class="imsc-lance-pips">
                                {{#each this.lance.tiers}}
                                <div class="imsc-lance-tier-group {{#if this.isActive}}imsc-lance-tier-active{{/if}}">
                                    <span class="imsc-lance-tier-label">{{this.label}}</span>
                                    <span class="imsc-lance-tier-dmg">×{{this.multiplier}}</span>
                                    <span class="imsc-lance-tier-ap">{{this.min}} AP</span>
                                </div>
                                {{/each}}
                            </div>
                            <span class="imsc-lance-charge-value">{{this.lance.power}}/{{this.lance.powerMax}}</span>
                        </div>
                        {{!-- Active tier + fire --}}
                        <div class="imsc-battery-actions">
                            {{#if this.lance.canFire}}
                            <button class="imsc-battery-fire-btn imsc-fire--lance" data-action="fireWeapon" data-fire-mode="lanceFire" data-weapon-id="{{this.id}}">
                                <i class="fa-solid fa-bolt-lightning"></i>
                                {{#if this.lance.activeTierLabel}}
                                    {{this.lance.activeTierLabel}} ({{this.lance.activeDamage}} dmg)
                                {{else}}
                                    {{localize "IMSC.Gunner.LanceFire"}}
                                {{/if}}
                            </button>
                            {{else}}
                            <span class="imsc-fire-blocked"><i class="fa-solid fa-battery-empty"></i> {{localize "IMSC.Warning.InsufficientAP"}}</span>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}

                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{!-- POINT DEFENSE  -  simple fire                    --}}
                    {{!-- ═══════════════════════════════════════════════ --}}
                    {{#if (imscEq this.system.resourceType "none")}}
                    <div class="imsc-battery-body imsc-battery--pd">
                        <div class="imsc-battery-stats-row">
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Damage"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.damage}}</span>
                            </div>
                            <div class="imsc-battery-stat">
                                <span class="imsc-battery-stat-label">{{localize "IMSC.Label.Range"}}</span>
                                <span class="imsc-battery-stat-value">{{this.system.range}}</span>
                            </div>
                        </div>
                        <div class="imsc-battery-actions">
                            <button class="imsc-battery-fire-btn imsc-fire--pd" data-action="fireWeapon" data-fire-mode="pointDefense" data-weapon-id="{{this.id}}">
                                <i class="fa-solid fa-shield-halved"></i> {{localize "IMSC.Gunner.Fire"}}
                            </button>
                        </div>
                    </div>
                    {{/if}}

                </div>
                {{/each}}
            {{else}}
                <div class="list-row">
                    <div class="row-content"><span class="imsc-empty-slot">{{localize "IMSC.Label.Empty"}}</span></div>
                </div>
            {{/if}}
        </div>
    </div>
    {{/each}}

    {{> 'modules/impmal-shipcombat/templates/actor/partials/complete-turn.hbs' tabRoleId="gunner" turnDone=(lookup @root.sys.turnDone "gunner")}}

</section>
{{!-- ship-gunner.hbs – Master of Ordnance tab --}}
