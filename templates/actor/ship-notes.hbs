<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
    {{#if (isGM)}}
        <div class="editor-section">
            <div class="header">{{localize "IMSC.Label.GMNotes"}}</div>
            <div class="editor">
                <div class="editor-content" data-edit="system.notes.gm">
                    {{{sys.notes.gm}}}
                </div>
            </div>
        </div>
    {{/if}}

    <div class="editor-section">
        <div class="header">{{localize "IMSC.Label.ShipLog"}}</div>
        <div class="editor">
            <div class="editor-content" data-edit="system.notes.player">
                {{{sys.notes.player}}}
            </div>
        </div>
    </div>
</section>
