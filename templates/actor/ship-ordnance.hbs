<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    {{#with (lookup roles "ordnance")}}
    {{#unless isMyRole}}
        {{#unless @root.isGM}}
        <div class="sheet-list">
            <div class="list-content">
                <div class="list-row">
                    <div class="row-content">
                        <div class="list-name">{{localize "IMSC.Prompt.ClaimRole"}}</div>
                        <div class="list-controls">
                            <button data-action="claimRole" data-role-id="ordnance">
                                <i class="fa-solid fa-rocket"></i> {{localize "IMSC.Role.Ordnance"}}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/unless}}
    {{/unless}}
    {{/with}}

    {{!-- ═══════ Captain Boost Banner ═══════ --}}
    {{#if ordnanceCtx.captainBoosts.length}}
    <div class="imsc-captain-boost-bar">
        <span class="imsc-captain-boost-bar-label"><i class="fa-solid fa-flag"></i> {{localize "IMSC.Captain.ActiveOrdersShort"}}:</span>
        {{#each ordnanceCtx.captainBoosts}}
        <span class="imsc-captain-boost-chip">{{label}}</span>
        {{/each}}
    </div>
    {{/if}}

    {{!-- ═══════ Status Bar (docked) ═══════ --}}
    <div class="sheet-list imsc-role-status-bar">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Ordnance.StatusTitle"}}</div>
            {{#with (lookup roles "ordnance")}}
            {{> "modules/impmal-shipcombat/templates/actor/partials/core-status-banner.hbs"
                coreCount=coreCount coreActionsPlayedLabels=coreActionsPlayedLabels hasCoreStaged=hasCoreStaged}}
            {{/with}}
        </div>
        <div class="list-content">
            <div class="imsc-role-status-panel">
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Ordnance.OP"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--plasma">
                        <div class="imsc-resource-bar-fill imsc-bar-op" style="width: {{ordnanceCtx.mpPct}}%"></div>
                        {{#if ordnanceCtx.mpLostPct}}
                        <div class="imsc-bar-lost" style="left: {{ordnanceCtx.mpPct}}%; width: {{ordnanceCtx.mpLostPct}}%"></div>
                        {{/if}}
                    </div>
                    <span class="imsc-resource-bar-value" style="color: #00ff88">{{ordnanceCtx.manpower}}/{{ordnanceCtx.manpowerMax}}</span>
                </div>
                <div class="imsc-resource-bar-row">
                    <span class="imsc-resource-bar-label">{{localize "IMSC.Sensors.PowerTrack"}}</span>
                    <div class="imsc-resource-bar-track imsc-resource-bar-track--aux">
                        <div class="imsc-resource-bar-fill imsc-bar-aux" style="width: {{ordnanceCtx.auxPowerPct}}%"></div>
                    </div>
                    <span class="imsc-resource-bar-value" style="color: #7ec8e3">{{ordnanceCtx.auxPower}}/{{ordnanceCtx.auxPowerMax}}</span>
                </div>
            </div>

            {{!-- Ordnance Readiness  -  three side-by-side cards --}}
            <div class="imsc-ordnance-cards">

                {{!-- Torpedo card --}}
                <div class="imsc-ord-card">
                    <div class="imsc-ord-card-header">
                        <i class="fa-solid fa-rocket"></i>
                        <span>{{localize "IMSC.Ordnance.Torpedoes"}}</span>
                    </div>
                    <div class="imsc-ord-card-body">
                        {{#if ordnanceCtx.readyTorpedoes}}
                        <span class="imsc-ord-badge imsc-ord-badge--ready">
                            <i class="fa-solid fa-circle"></i> {{ordnanceCtx.readyTorpedoes}} {{localize "IMSC.Ordnance.Armed"}}
                        </span>
                        {{/if}}
                        {{#if ordnanceCtx.loadingTorpedoes}}
                        <span class="imsc-ord-badge imsc-ord-badge--loading">
                            <i class="fa-solid fa-circle"></i> {{ordnanceCtx.loadingTorpedoes}} {{localize "IMSC.Ordnance.Loading"}}
                        </span>
                        {{/if}}
                        {{#if ordnanceCtx.deployedTorpedoCount}}
                        <span class="imsc-ord-badge imsc-ord-badge--deployed">
                            <i class="fa-solid fa-circle"></i> {{ordnanceCtx.deployedTorpedoCount}} {{localize "IMSC.Ordnance.InFlight"}}
                        </span>
                        {{/if}}
                        {{#unless ordnanceCtx.readyTorpedoes}}
                        {{#unless ordnanceCtx.loadingTorpedoes}}
                        {{#unless ordnanceCtx.deployedTorpedoCount}}
                        <span class="imsc-ord-badge imsc-ord-badge--none">{{localize "IMSC.Ordnance.NoneReady"}}</span>
                        {{/unless}}
                        {{/unless}}
                        {{/unless}}
                        {{#if ordnanceCtx.hasTorpedoConfig}}
                        <span class="imsc-ord-badge {{#if (imscEq ordnanceCtx.autoArmTimer 1)}}imsc-ord-badge--ready{{else}}imsc-ord-badge--loading{{/if}}"
                              data-tooltip="{{localize 'IMSC.Ordnance.AutoArmTooltip'}}">
                            <i class="fa-solid fa-clock"></i> {{localize 'IMSC.Ordnance.AutoArm'}}: {{ordnanceCtx.autoArmTimer}}T
                        </span>
                        {{/if}}
                    </div>
                </div>

                {{!-- Strike Craft card --}}
                <div class="imsc-ord-card imsc-ord-card--craft">
                    <div class="imsc-ord-card-header">
                        <i class="fa-solid fa-jet-fighter"></i>
                        <span>{{localize "IMSC.Ordnance.StrikeCraft"}}</span>
                        <span class="imsc-ord-flights">{{ordnanceCtx.deployedCraftCount}}/{{ordnanceCtx.maxFlights}}</span>
                    </div>
                    <div class="imsc-ord-card-body">
                        <div class="imsc-ordnance-pips">
                            {{#each ordnanceCtx.craftPips}}
                            <div class="imsc-ordnance-pip imsc-ordnance-pip--{{state}}"></div>
                            {{/each}}
                        </div>
                    </div>
                </div>

                {{!-- Payload card --}}
                <div class="imsc-ord-card">
                    <div class="imsc-ord-card-header">
                        <i class="fa-solid fa-box"></i>
                        <span>{{localize "IMSC.Ordnance.Payloads"}}</span>
                    </div>
                    <div class="imsc-ord-card-body">
                        {{#if ordnanceCtx.activePayloadCount}}
                        <span class="imsc-ord-badge imsc-ord-badge--ready">
                            <i class="fa-solid fa-circle"></i> {{ordnanceCtx.activePayloadCount}} {{localize "IMSC.Ordnance.Active"}}
                        </span>
                        {{/if}}
                        {{#if ordnanceCtx.loadingPayloadCount}}
                        <span class="imsc-ord-badge imsc-ord-badge--deployed">
                            <i class="fa-solid fa-circle"></i> {{ordnanceCtx.loadingPayloadCount}} {{localize "IMSC.Ordnance.Loading"}}
                        </span>
                        {{/if}}
                        {{#if ordnanceCtx.availablePayloads}}
                        <span class="imsc-ord-badge imsc-ord-badge--ready">
                            <i class="fa-solid fa-circle"></i> {{ordnanceCtx.availablePayloads}} {{localize "IMSC.Ordnance.Available"}}
                        </span>
                        {{/if}}
                        {{#if ordnanceCtx.manpowerMax}}
                        <span class="imsc-ord-badge {{#if (imscEq ordnanceCtx.autoLoadTimer 1)}}imsc-ord-badge--ready{{else}}imsc-ord-badge--loading{{/if}}"
                              data-tooltip="{{localize 'IMSC.Ordnance.AutoLoadTooltip'}}">
                            <i class="fa-solid fa-clock"></i> {{localize 'IMSC.Ordnance.AutoLoad'}}: {{ordnanceCtx.autoLoadTimer}}T
                        </span>
                        {{/if}}
                        {{#unless ordnanceCtx.activePayloadCount}}
                        {{#unless ordnanceCtx.loadingPayloadCount}}
                        {{#unless ordnanceCtx.availablePayloads}}
                        <span class="imsc-ord-badge imsc-ord-badge--none">{{localize "IMSC.Ordnance.NoneReady"}}</span>
                        {{/unless}}
                        {{/unless}}
                        {{/unless}}
                    </div>
                </div>

            </div>

            {{!-- Active Commitments (condensed inline) --}}
            {{#if ordnanceCtx.commitments.length}}
            <div class="imsc-commitments-inline">
                {{#each ordnanceCtx.commitments}}
                <span class="imsc-commitment-pill {{#if isNew}}imsc-commitment-pill--new{{/if}} {{#if noCancel}}imsc-commitment-pill--locked{{/if}}"
                      data-tooltip="{{actionLabel}}  -  {{crewCount}} crew, {{turnsRemaining}} turn(s) left{{#if completionBenefit}} | Benefit awarded on completion{{/if}}{{#if isNew}}{{#if noCancel}} | Cannot cancel: effect already applied{{else}} | Right-click to cancel{{/if}}{{/if}}"
                      data-index="{{index}}">
                    <i class="{{icon}}"></i> {{crewCount}}<i class="fa-solid fa-user fa-xs"></i> {{turnsRemaining}}T{{#if noCancel}}<i class="fa-solid fa-lock fa-xs" style="margin-left:2px;opacity:0.6"></i>{{/if}}
                </span>
                {{/each}}
            </div>
            {{/if}}
        </div>
    </div>

    {{!-- ═══════ Ordnance Master SL Requisition ═══════ --}}
    <div class="sheet-list">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Ordnance.Requisition"}}</div>
        </div>
        <div class="list-content imsc-helm-panel">
            <div class="imsc-helm-stats">
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Ordnance.RequisitionDesc'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Ordnance.RequisitionSL"}}</span>
                    {{#if ordnanceCtx.bosunRolled}}
                        <span class="imsc-helm-stat-value imsc-sl-badge">{{ordnanceCtx.slRemaining}}</span>
                    {{else}}
                        <button class="imsc-roll-piloting-btn" data-action="rollOrdnanceMaster">
                            <i class="fa-solid fa-dice"></i> {{localize "IMSC.Ordnance.RollRequisition"}}
                        </button>
                    {{/if}}
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Ordnance.EfficiencyTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Ordnance.Efficiency"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocOrdnanceSL" data-stat="efficiency" data-delta="-1"
                                {{#unless ordnanceCtx.bosunRolled}}disabled{{/unless}}
                                {{#unless ordnanceCtx.allocEfficiency}}disabled{{/unless}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{ordnanceCtx.allocEfficiency}}</span>
                        <button class="imsc-alloc-btn" data-action="allocOrdnanceSL" data-stat="efficiency" data-delta="1"
                                {{#unless ordnanceCtx.bosunRolled}}disabled{{/unless}}
                                {{#if (gte (add ordnanceCtx.allocEfficiency ordnanceCtx.allocExpedience) ordnanceCtx.bosunSL)}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
                <div class="imsc-helm-stat" data-tooltip="{{localize 'IMSC.Ordnance.ExpedienceTooltip'}}">
                    <span class="imsc-helm-stat-label">{{localize "IMSC.Ordnance.Expedience"}}</span>
                    <div class="imsc-alloc-row">
                        <button class="imsc-alloc-btn" data-action="allocOrdnanceSL" data-stat="expedience" data-delta="-1"
                                {{#unless ordnanceCtx.bosunRolled}}disabled{{/unless}}
                                {{#unless ordnanceCtx.allocExpedience}}disabled{{/unless}}>
                            &minus;
                        </button>
                        <span class="imsc-helm-stat-value">{{ordnanceCtx.allocExpedience}}</span>
                        <button class="imsc-alloc-btn" data-action="allocOrdnanceSL" data-stat="expedience" data-delta="1"
                                {{#unless ordnanceCtx.bosunRolled}}disabled{{/unless}}
                                {{#if (gte (add ordnanceCtx.allocEfficiency ordnanceCtx.allocExpedience) ordnanceCtx.bosunSL)}}disabled{{/if}}>
                            +
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{!-- ═══════ Main Actions (crew commitment) ═══════ --}}
    <div class="sheet-list imsc-ordnance-actions">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Ordnance.MainAction"}}</div>
        </div>
        <div class="list-content">
            <div class="imsc-ordnance-action-grid imsc-action-grid-2col">
                {{#each ordnanceCtx.actions}}
                <button class="imsc-ordnance-action-btn" data-action="ordnanceMasterAction" data-action-id="{{id}}"
                        {{#unless canAfford}}disabled{{/unless}}
                        data-tooltip="{{descLocalized}}">
                    <i class="{{icon}}"></i>
                    <span>{{labelLocalized}}</span>
                    <small>{{effectiveCrew}} crew / {{effectiveDuration}}T</small>
                </button>
                {{/each}}
            </div>
        </div>
    </div>

    {{!-- ═══════ Payload Allocation ═══════ --}}
    <div class="sheet-list imsc-payload-section">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Ordnance.PayloadAllocation"}}</div>
        </div>
        <div class="list-content">
            {{#each ordnanceCtx.payloadOptions}}
            <div class="imsc-payload-role-row">
                <span class="imsc-payload-role-label">{{roleLabel}}</span>
                <div class="imsc-payload-buttons">
                    {{#each items}}
                    <button class="imsc-payload-btn"
                            data-action="sendPayload" data-payload-id="{{id}}"
                            {{#unless canSend}}disabled{{/unless}}
                            data-tooltip="{{descLocalized}}">
                        <i class="{{icon}}"></i>
                        <span>{{labelLocalized}}</span>
                    </button>
                    {{/each}}
                    {{#if hasActive}}
                    <div class="imsc-payload-deployed-overlay">
                        <i class="fa-solid fa-check-circle"></i> {{localize "IMSC.Ordnance.Deployed"}}
                    </div>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- ═══════ Logistics Doctrines (Core Actions) ═══════ --}}
    <div class="sheet-list imsc-ordnance-core-actions imsc-role-section">
        {{!-- Overlay: only "No Power Core" when none available --}}
        {{#unless ordnanceCtx.hasCoreAssigned}}
        <div class="imsc-section-overlay imsc-section-overlay--taken">
            <div class="imsc-overlay-lock-indicator">
                <i class="fa-solid fa-lock fa-lg"></i>
                <span>{{localize "IMSC.Tooltip.NoPowerCore"}}</span>
            </div>
        </div>
        {{/unless}}

        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Label.CoreActions"}}</div>
        </div>
        <div class="list-content">
            {{#each ordnanceCtx.coreActions}}
            <div class="imsc-core-action-card">
                <button class="imsc-core-action-btn" data-action="ordnanceMasterCoreAction" data-core-action="{{id}}"
                        {{#unless canAfford}}disabled{{/unless}}
                        data-tooltip="{{descLocalized}}">
                    <i class="{{icon}}"></i>
                    <span>{{labelLocalized}}</span>
                    <small>{{localize "IMSC.Label.PowerCores"}}</small>
                </button>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- ═══════ Deployed Ordnance Panel ═══════ --}}
    <div class="sheet-list imsc-deployed-ordnance">
        <div class="list-header row-content">
            <div class="list-name">{{localize "IMSC.Ordnance.DeployedOrdnance"}} ({{ordnanceCtx.deployedCount}})</div>
        </div>
        <div class="list-content">
            {{#unless ordnanceCtx.deployedCount}}
            <div class="imsc-deployed-empty">
                {{localize "IMSC.Ordnance.NoneDeployed"}}
            </div>
            {{/unless}}

            {{!-- Torpedoes --}}
            {{#each ordnanceCtx.deployedTorpedoes}}
            <div class="imsc-deployed-row imsc-deployed--torpedo {{#if turnComplete}}imsc-deployed--done{{/if}}"
                 data-token-id="{{tokenId}}">
                <img src="{{img}}" class="imsc-deployed-icon" />
                <span class="imsc-deployed-name">{{name}}</span>
                <span class="imsc-deployed-type"><i class="fa-solid fa-rocket"></i></span>
                <div class="imsc-deployed-controls">
                    <button data-action="panToOrdnance" data-token-id="{{tokenId}}"
                            data-tooltip="{{localize 'IMSC.Ordnance.PanTo'}}">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                    <button data-action="markOrdnanceDone" data-token-id="{{tokenId}}"
                            class="{{#if turnComplete}}active{{/if}}"
                            data-tooltip="{{localize 'IMSC.Ordnance.MarkDone'}}">
                        <i class="fa-solid fa-check"></i>
                    </button>
                </div>
            </div>
            {{/each}}

            {{!-- Strike Craft --}}
            {{#each ordnanceCtx.deployedCraft}}
            <div class="imsc-deployed-row imsc-deployed--craft {{#if turnComplete}}imsc-deployed--done{{/if}}"
                 data-token-id="{{tokenId}}">
                <img src="{{img}}" class="imsc-deployed-icon" />
                <span class="imsc-deployed-name">{{name}}</span>
                <span class="imsc-deployed-type">
                    <i class="fa-solid fa-jet-fighter-up"></i>
                </span>
                <div class="imsc-deployed-hull">
                    <span>{{hull.value}}/{{hull.max}}</span>
                </div>
                <div class="imsc-deployed-controls">
                    <button data-action="panToOrdnance" data-token-id="{{tokenId}}"
                            data-tooltip="{{localize 'IMSC.Ordnance.PanTo'}}">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                    <button data-action="markOrdnanceDone" data-token-id="{{tokenId}}"
                            class="{{#if turnComplete}}active{{/if}}"
                            data-tooltip="{{localize 'IMSC.Ordnance.MarkDone'}}">
                        <i class="fa-solid fa-check"></i>
                    </button>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- ═══════ Complete Turn ═══════ --}}
    {{> 'modules/impmal-shipcombat/templates/actor/partials/complete-turn.hbs' tabRoleId="ordnance" turnDone=(lookup @root.sys.turnDone "ordnance")}}

</section>
