{{!-- tabs/5/gunner.hbs — Gunnery Officer tab (≤ 5 players) --}}
{{!-- Same as 6-man but with Deployed Torpedoes above Mark Action Done. --}}
<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    {{> "modules/impmal-shipcombat/templates/actor/partials/gunner-claim-prompt.hbs"}}

    {{#if (or isGM (lookup (lookup roles "gunner") "isMyRole"))}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/gunner-captain-boost.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/gunner-status-bar.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/gunner-ordnance-allocation.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/gunner-core-actions.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/gunner-weapon-batteries.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/deployed-torpedoes.hbs"}}
    {{/if}}

    {{> 'modules/impmal-shipcombat/templates/actor/partials/complete-turn.hbs' tabRoleId="gunner" turnDone=(lookup @root.sys.turnDone "gunner")}}

</section>
