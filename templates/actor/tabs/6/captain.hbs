    {{> "modules/impmal-shipcombat/templates/actor/partials/captain-core-actions.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/captain-hand.hbs"}}
    {{> "modules/impmal-shipcombat/templates/actor/partials/captain-active-orders.hbs"}}
