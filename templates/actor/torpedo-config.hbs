<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
<div class="imsc-torpedo-sheet">

    {{!-- Warhead Count --}}
    <div class="imsc-torpedo-bar">
        <label>Warheads</label>
        <div class="imsc-torpedo-bar-track">
            <div class="imsc-torpedo-bar-fill hull" style="width: {{hullPct}}%"></div>
            <span class="imsc-torpedo-bar-text">
                <input type="number" name="system.hull.value" value="{{sys.hull.value}}" class="imsc-torpedo-inline" />
                /
                <input type="number" name="system.hull.max" value="{{sys.hull.max}}" class="imsc-torpedo-inline" />
            </span>
        </div>
    </div>

    {{!-- Fuel --}}
    <div class="imsc-torpedo-bar">
        <label>Fuel</label>
        <div class="imsc-torpedo-bar-track">
            <div class="imsc-torpedo-bar-fill fuel" style="width: {{fuelPct}}%"></div>
            <span class="imsc-torpedo-bar-text">
                <input type="number" name="system.fuel.value" value="{{sys.fuel.value}}" class="imsc-torpedo-inline" />
                /
                <input type="number" name="system.fuel.max" value="{{sys.fuel.max}}" class="imsc-torpedo-inline" />
            </span>
        </div>
    </div>

    {{!-- Stat grid --}}
    <div class="imsc-torpedo-stats">
        <div class="imsc-torpedo-stat">
            <label>SPD</label>
            <input type="number" name="system.movement.speed" value="{{sys.movement.speed}}" />
        </div>
        <div class="imsc-torpedo-stat">
            <label>MAN</label>
            <input type="number" name="system.movement.maneuverability" value="{{sys.movement.maneuverability}}" />
        </div>
        <div class="imsc-torpedo-stat">
            <label>DMG</label>
            <input type="number" name="system.payloadDamage" value="{{sys.payloadDamage}}" />
        </div>
        <div class="imsc-torpedo-stat">
            <label>RADIUS</label>
            <input type="number" name="system.payloadRadius" value="{{sys.payloadRadius}}" />
        </div>
    </div>

    {{!-- Traits --}}
    <div class="imsc-torpedo-traits">
        <h4>Warhead Traits</h4>
        <div class="imsc-torpedo-trait-grid">
            <div class="imsc-torpedo-trait">
                <label>Rend</label>
                <input type="number" name="system.traits.rend" value="{{sys.traits.rend}}" />
            </div>
            <div class="imsc-torpedo-trait">
                <label>AP</label>
                <input type="number" name="system.traits.armourPenetration" value="{{sys.traits.armourPenetration}}" />
            </div>
            <div class="imsc-torpedo-trait">
                <label>Shd Burn</label>
                <input type="number" name="system.traits.shieldBurn" value="{{sys.traits.shieldBurn}}" />
            </div>
            <div class="imsc-torpedo-trait">
                <label>Shd Bypass</label>
                <input type="checkbox" name="system.traits.shieldBypass" {{checked sys.traits.shieldBypass}} />
            </div>
        </div>
    </div>
</div>
</section>
