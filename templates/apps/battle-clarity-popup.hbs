{{!-- battle-clarity-popup.hbs  -  Battle Clarity core action target picker --}}
<div class="imsc-tp-wrapper">

    {{#if noTargets}}
    <div class="imsc-tp-empty">
        <i class="fa-solid fa-ban"></i>
        {{localize "IMSC.Captain.Core.BCNoTargets"}}
    </div>
    {{else}}
    <div class="imsc-tp-targets">
        {{#each targets}}
        <div class="imsc-tp-target">
            <img src="{{this.img}}" class="imsc-tp-target-icon">
            <div class="imsc-tp-target-info">
                <span class="imsc-tp-target-name">{{this.name}}</span>
            </div>
            <div class="imsc-tp-target-stats">
                <div class="imsc-tp-lock-badge" style="color:{{this.lockColour}};border-color:{{this.lockColour}}">
                    {{this.lockLabel}}
                </div>
            </div>
            <button class="imsc-tp-fire-btn" data-action="confirmDesignate" data-token-id="{{this.tokenId}}"
                    data-tooltip="{{localize "IMSC.Captain.Core.BCDesignate"}}">
                <i class="fa-solid fa-crosshairs"></i>
            </button>
        </div>
        {{/each}}
    </div>
    {{/if}}

</div>
