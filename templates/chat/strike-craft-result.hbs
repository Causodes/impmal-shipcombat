{{!-- strike-craft-result.hbs  -  Chat card for strike craft attack results --}}
<div class="imsc-fire-result">

    {{!-- ═══ Header ═══ --}}
    <div class="imsc-fire-header">
        {{#if weaponImg}}
        <img src="{{weaponImg}}" class="imsc-fire-icon" alt="{{weaponName}}">
        {{/if}}
        <div class="imsc-fire-title">
            <strong>{{weaponName}}</strong>
            <span class="imsc-fire-mode">{{fireModeLabel}}</span>
        </div>
    </div>

    {{!-- ═══ Target Row ═══ --}}
    <div class="imsc-fire-target-row">
        <i class="fa-solid fa-crosshairs"></i>
        <span>{{targetName}}</span>
        <span class="imsc-fire-quadrant">({{hitQuadrantLabel}})</span>
    </div>

    {{!-- ═══ Salvo Summary ═══ --}}
    {{#if totalSalvo}}
    <div class="imsc-fire-salvo-summary">
        <div class="imsc-fire-detail">
            <i class="fa-solid fa-plane-departure"></i>
            <strong>{{totalHits}}</strong> / {{totalSalvo}} {{localize "IMSC.Fire.ShotsHit"}}
            {{#if accuracy}}
                <span class="imsc-fire-tn-inline">vs {{accuracy}}</span>
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{!-- ═══ Salvo Die (single d100 roll) ═══ --}}
    {{#if hasSalvoRolls}}
    <div class="imsc-fire-salvo-rolls">
        {{#each salvoRolls}}
        <span class="imsc-salvo-die imsc-salvo-reveal {{#if this.hit}}imsc-fire-success{{else}}imsc-fire-failure{{/if}}"
              style="{{{this.dieStyle}}}"
              title="{{this.roll}} vs {{this.target}}">
            {{this.roll}}
        </span>
        {{/each}}
    </div>
    {{/if}}

    {{!-- ═══ Outcome Label ═══ --}}
    {{#if rollResult}}
    <div class="imsc-fire-roll">
        <span class="imsc-fire-outcome {{#if hit}}imsc-fire-success{{else}}imsc-fire-failure{{/if}}">
            {{#if isCrit}}{{localize "IMSC.Fire.CriticalHit"}}{{else if hit}}{{localize "IMSC.Fire.Hit"}}{{else}}{{localize "IMSC.Fire.Miss"}}{{/if}}
        </span>
    </div>
    {{/if}}

    {{!-- ═══ Shield Resolution ═══ --}}
    {{#if hasShieldResults}}
    <div class="imsc-fire-shields">
        <i class="fa-solid fa-shield-halved"></i>
        {{#if shieldResults.bypassed}}
            <span class="imsc-shield-bypass">{{localize "IMSC.Fire.ShieldBypassed"}}</span>
        {{else}}
            <span>{{shieldResults.absorbed}} {{localize "IMSC.Fire.Absorbed"}} ({{shieldResults.shieldCostTotal}} {{localize "IMSC.Fire.ShieldDrain"}})</span>
            <span class="imsc-shield-through">→ {{shieldResults.hitsThroughShield}} {{localize "IMSC.Fire.Through"}}</span>
        {{/if}}
    </div>
    {{/if}}

    {{!-- ═══ Damage Resolution ═══ --}}
    {{#if hasDamageResults}}
    <div class="imsc-fire-damage">
        <div class="imsc-fire-damage-header">
            <i class="fa-solid fa-explosion"></i>
            <strong>{{damageResults.totalDamage}}</strong> {{localize "IMSC.Fire.HullDamage"}}
        </div>
        <div class="imsc-fire-damage-detail">
            ({{damageResults.rawDamagePerHit}} − {{damageResults.effectiveArmour}} {{localize "IMSC.Fire.Armour"}})
            {{#if damageResults.ap}}
                <span class="imsc-fire-ap">[AP {{damageResults.ap}}]</span>
            {{/if}}
        </div>
        {{#if damageResults.rendTotal}}
        <div class="imsc-fire-rend">
            <i class="fa-solid fa-hammer"></i>
            {{localize "IMSC.Fire.Rend"}}: −{{damageResults.rendTotal}} {{localize "IMSC.Fire.SectorArmour"}}
        </div>
        {{/if}}
    </div>
    {{/if}}

    {{!-- ═══ Critical Hit ═══ --}}
    {{#if critResult.hasCrit}}
    <div class="imsc-fire-crit">
        <div class="imsc-fire-crit-header">
            <i class="fa-solid fa-skull"></i>
            <strong>{{localize "IMSC.Crit.Hit"}}</strong>
            <span class="imsc-crit-tier-badge imsc-crit-tier--{{critResult.finalTier}}">{{critResult.tierLabel}}</span>
        </div>
        <div class="imsc-fire-crit-detail">
            <span class="imsc-crit-location-label">{{critResult.locLabel}}</span>
            <span class="imsc-crit-sep">  -  </span>
            <span class="imsc-crit-condition-label">{{critResult.condLabel}}</span>
        </div>
        {{#if critResult.detail}}
        <div class="imsc-fire-crit-note">{{critResult.detail}}</div>
        {{/if}}
        {{#if critResult.jammedItemName}}
        <div class="imsc-fire-crit-note">
            <i class="fa-solid fa-gun-slash"></i> {{critResult.jammedItemName}} {{localize "IMSC.Crit.JammedSuffix"}}
        </div>
        {{/if}}
    </div>
    {{/if}}

</div>
